<%# Reportes U039: rango explícito y resultados calculados en MySQL. %>
<div class="ops-stack" id="reports-module">
  <form class="ops-range app-fields--toolbar" id="report-range">
    <div class="app-field"><label class="app-label" for="report-from">Desde</label><input class="app-input" id="report-from" name="from" type="date" required></div>
    <div class="app-field"><label class="app-label" for="report-to">Hasta</label><input class="app-input" id="report-to" name="to" type="date" required></div>
  </form>
  <div class="ops-dashboard" id="report-summary" aria-live="polite" aria-busy="true"><p>Cargando reporte…</p></div>
  <section class="ops-section"><div class="ops-section-heading"><h3>Productos más vendidos</h3></div><div id="report-top"></div></section>
  <section class="ops-section"><div class="ops-section-heading"><h3>Cierres de caja</h3></div><div id="report-cash"></div></section>
</div>
