<%# Regiones accesibles de ModuleLayout; comparten presentación con los avisos de formulario. %>
<section class="module-messages" data-module-region="messages" aria-labelledby="module-messages-title">
  <h2 id="module-messages-title">Mensajes</h2>
  <div class="module-message app-alert" data-module-status data-kind="info" role="status" aria-live="polite" aria-atomic="true">
    <span class="module-message-symbol app-alert-icon" aria-hidden="true">
      <% for (const kind of ['info', 'success', 'warning', 'loading', 'empty']) { %>
        <span data-message-icon="<%= kind %>"<% if (kind !== 'info') { %> hidden<% } %>><%- include('../icon', { name: kind === 'loading' ? 'refresh' : kind === 'empty' ? 'box' : kind }) %></span>
      <% } %>
    </span>
    <p data-module-status-text><%= moduleUi.message %></p>
  </div>
  <div class="module-message app-alert" data-module-error data-kind="error" role="alert" aria-atomic="true" hidden>
    <span class="module-message-symbol app-alert-icon"><%- include('../icon', { name: 'error' }) %></span><p data-module-error-text></p>
  </div>
</section>
